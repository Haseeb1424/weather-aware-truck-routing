# Local development
DJANGO_DEBUG=true

# Production (optional — a random key is used when unset; the app signs nothing)
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=your-app.onrender.com

# Optional overrides — all services are keyless by default
# OSRM_URL=https://router.project-osrm.org
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=            # commercial key lifts the free-tier rate limit
# PHOTON_URL=https://photon.komoot.io/api/
# API_RATE_LIMIT=120/min
